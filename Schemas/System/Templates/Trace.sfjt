//
// Schmema for the trace information that can be added to
// each message to support Pipeline Metrics 
//
{
    type: array,
    items : {
        type: object,
            additionalProperties: false,           
            properties: {
            event:    {type: string},
            ts:       {type: number},
            domain:   {type: string},
            group:    {type: string},
            pipeline: {type: string},
            name:     {type: string},
            value:    {type: number},
        },
        required: [event, ts, domain, group, pipeline, name],
    },
}