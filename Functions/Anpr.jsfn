//sfTimestamp:1786197460759
//sfLabel:Anpr.jsfn
async function (name, input, context, config) {
    
    const vrm = input.data.vrm;
    let result = {}

    if (vrm in config) {
        result.outputs = {
            alert: {
                kind: "alert",
                alert: {
                    type: "ANPR Alert",
                    subject: vrm,
                    message: config[vrm]
                    origin: name,
                },
                details: input.data,
            }
        }
    }
}