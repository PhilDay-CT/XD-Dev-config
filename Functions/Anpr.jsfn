//sfTimestamp:1786312535077
//sfLabel:Functions/Anpr.jsfn
async function (name, input, context, config) {
    
    console.dir(input, {depth: null})
    console.dir(config, {depth: null})
    const vrm = input.data.vrm;
    let result = {
        outputs: {
            default: input 
        }
    };

    if (vrm in config.Application) {
        result.outputs['alert'] = {
            kind: "alert",
            alert: {
                type: "ANPR Alert",
                subject: vrm,
                message: config[vrm],
                origin: name,
            },
            details: input.data,
        }
    };

    return result;
}