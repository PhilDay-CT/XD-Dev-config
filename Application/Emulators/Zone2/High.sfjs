                ThingsBoard: {token: "Token5"}
            },

            deadbeef00000006: $EMULATOR_1 << {
                ThingsBoard: {token: "Token6"}
            },

            deadbeef00000007: $EMULATOR_1 << {
                ThingsBoard: {token: "Token7"}
            },

            deadbeef00000008: $EMULATOR_1 << {
